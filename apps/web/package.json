{
  "name": "smartify",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && node ../../scripts/generate-sw.mjs",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "serve": "npm run build && npx serve -s build/client -l 4173",
    "typecheck": "react-router typegen && tsc",
    "lint": "react-router typegen && eslint .",
    "lint:fix": "react-router typegen && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@mantine/core": "^9.3.1",
    "@mantine/form": "^9.3.1",
    "@mantine/hooks": "^9.3.1",
    "@mantine/notifications": "^9.3.1",
    "@mantine/nprogress": "^9.3.1",
    "@react-router/node": "7.16.0",
    "@react-router/serve": "7.16.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tabler/icons-react": "^3.44.0",
    "axios": "^1.18.1",
    "dexie": "^4.4.4",
    "isbot": "^5.1.36",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "7.16.0",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.1",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "7.16.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "postcss": "^8.5.16",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.3",
    "workbox-build": "^7.4.1"
