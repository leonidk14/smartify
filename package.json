{
  "name": "dgw",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w smartify",
    "build": "npm run build -w smartify",
    "start": "npm run start -w smartify",
    "serve": "npm run serve -w smartify",
    "typecheck": "npm run typecheck -w smartify",
    "lint": "npm run lint -w smartify",
    "lint:fix": "npm run lint:fix -w smartify",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "deno:fmt": "deno fmt --config supabase/functions/deno.json supabase/functions",
    "deno:check": "deno fmt --check --config supabase/functions/deno.json supabase/functions && deno lint --config supabase/functions/deno.json supabase/functions",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run deno:check",
    "test": "npm run test -w smartify",
    "landing:dev": "npm run dev -w smartify-landing",
    "landing:build": "npm run build -w smartify-landing",
    "landing:preview": "npm run preview -w smartify-landing"
  }
}
