{
  "name": "smartify",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/generate-sw.mjs",
    "start": "react-router-serve ./build/server/index.js",
    "serve": "npm run build && npx serve -s build/client -l 4173",
    "typecheck": "react-router typegen && tsc",
    "lint": "react-router typegen && eslint .",
    "lint:fix": "react-router typegen && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deno:fmt": "deno fmt --config supabase/functions/deno.json supabase/functions",
    "deno:check": "deno fmt --check --config supabase/functions/deno.json supabase/functions && deno lint --config supabase/functions/deno.json supabase/functions",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run deno:check",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@mantine/core": "^9.3.1",
    "@mantine/form": "^9.3.1",
    "@mantine/hooks": "^9.3.1",
    "@mantine/notifications": "^9.3.1",
    "@mantine/nprogress": "^9.3.1",
    "@react-router/node": "7.16.0",
    "@react-router/serve": "7.16.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tabler/icons-react": "^3.44.0",
    "axios": "^1.18.1",
    "dexie": "^4.4.4",
    "isbot": "^5.1.36",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "7.16.0",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@eslint-react/eslint-plugin": "^5.18.1",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "7.16.0",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^10.5.7",
    "globals": "^17.8.0",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "playwright": "latest",
    "postcss": "^8.5.16",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.3",
    "vitest": "latest",
    "workbox-build": "^7.4.1"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
